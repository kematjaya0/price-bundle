{
    "name": "kematjaya/price-bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "symfony/http-kernel": "^5.4",
        "symfony/dependency-injection": "^5.4",
        "symfony/config": "^5.4",
        "symfony/form": "^5.4",
        "twig/twig": "^3.3",
        "symfony/intl": "^5.4",
        "symfony/translation": "^5.4",
        "symfony/translation-contracts": "^2.5",
        "symfony/event-dispatcher": "^5.4",
        "symfony/yaml": "^5.4"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\PriceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\PriceBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.7",
        "symfony/var-dumper": "^5.4",
        "symfony/framework-bundle": "^5.4",
        "symfony/browser-kit": "^5.4"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "cs-check": "phpcs --standard=PSR12 --extensions=php src tests",
        "cs-fix": "phpcbf --standard=PSR12 --extensions=php src tests"
    }
}
