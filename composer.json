{
    "name": "kematjaya/price-bundle",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Nur Hidayatullah",
            "email": "kematjaya0@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "symfony/http-kernel": "^6.0|^7.0|^8.0",
        "symfony/dependency-injection": "^6.0|^7.0|^8.0",
        "symfony/config": "^6.0|^7.0|^8.0",
        "symfony/form": "^6.0|^7.0|^8.0",
        "twig/twig": "^6.0|^3.14|^4.0",
        "symfony/intl": "^6.0|^7.0|^8.0",
        "symfony/translation": "^6.0|^7.0|^8.0",
        "symfony/event-dispatcher": "^6.0|^7.0|^8.0",
        "symfony/yaml": "^6.0|^7.0|^8.0"
    },
    "autoload": {
        "psr-4": {
            "Kematjaya\\PriceBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kematjaya\\PriceBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5|^11.0",
        "symfony/var-dumper": "^6.0|^7.0|^8.0",
        "symfony/framework-bundle": "^6.0|^7.0|^8.0",
        "symfony/browser-kit": "^6.0|^7.0|^8.0",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0",
        "friendsofphp/php-cs-fixer": "^3.95"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "cs-check": "phpcs --standard=PSR12 --extensions=php src tests",
        "cs-fix": "phpcbf --standard=PSR12 --extensions=php src tests"
    }
}
